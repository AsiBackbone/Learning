{
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "**/toc.yml",
          "advanced/**/*.md",
          "ai-integration/**/*.md",
          "architecture/**/*.md",
          "aspnetcore/**/*.md",
          "getting-started/**/*.md",
          "governance/**/*.md",
          "labs/**/*.md",
          "samples/**/*.md",
          "security/**/*.md",
          "tutorials/**/*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "examples/**",
          "public/**"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "ASI Backbone Learning",
      "_appTitle": "ASI Backbone Learning",
      "_appLogoPath": "images/asibackbone-icon-50.png",
      "_appFaviconPath": "images/favicon.ico",
      "_enableSearch": true
    }
  }
}